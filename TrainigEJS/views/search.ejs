<!DOCTYPE html>
<html>
<head>
    <title><%= appName %> - Buscar</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body>
    <div class="container mt-4">
        <h1>Buscar Registros</h1>
        
        <div class="row mb-4">
            <div class="col-md-6">
                <a href="/" class="btn btn-secondary">← Volver al Inicio</a>
            </div>
        </div>
        
        <form method="POST" action="/search" class="mb-4">
            <div class="row">
                <div class="col-md-8">
                    <label class="form-label">Buscar por ID, Nombre o Email</label>
                    <input type="text" name="searchId" class="form-control" 
                           value="<%= searchId %>" 
                           placeholder="Ingrese ID, nombre o email..."
                           required>
                </div>
                <div class="col-md-4">
                    <label class="form-label">&nbsp;</label>
                    <button type="submit" class="btn btn-primary d-block">Buscar</button>
                </div>
            </div>
        </form>
        
        <% if (results !== null) { %>
            <div class="alert alert-info">
                <strong>Resultados:</strong> <%= results.length %> registro(s) encontrado(s)
            </div>
            
            <% if (results.length > 0) { %>
                <table class="table table-striped">
                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Nombre</th>
                            <th>Email</th>
                            <th>Departamento</th>
                            <th>Municipio</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% results.forEach(record => { %>
                            <% const dept = departments.find(d => d.code === record.departmentCode) %>
                            <% const town = towns.find(t => t.code === record.townCode) %>
                            <tr>
                                <td><%= record.id %></td>
                                <td><%= record.name %></td>
                                <td><%= record.email %></td>
                                <td><%= dept ? dept.name : 'N/A' %></td>
                                <td><%= town ? town.name : 'N/A' %></td>
                            </tr>
                        <% }) %>
                    </tbody>
                </table>
            <% } %>
        <% } %>
    </div>
</body>
</html>
                        <% }) %>
                    </tbody>
                </table>
            <% } else { %>
                <div class="alert alert-warning">
                    No se encontraron registros que coincidan con la búsqueda.
                </div>
            <% } %>
        <% } %>
    </div>
</body>
</html>
