<!DOCTYPE html>
<html>
<head>
    <title><%= appName %> - Editar</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body>
    <div class="container mt-4">
        <h1>Editar Registro</h1>
        
        <form method="POST" action="/edit/<%= record.id %>">
            <div class="mb-3">
                <label class="form-label">Nombre</label>
                <input type="text" name="name" class="form-control" value="<%= record.name %>" required>
            </div>
            
            <div class="mb-3">
                <label class="form-label">Email</label>
                <input type="email" name="email" class="form-control" value="<%= record.email %>" required>
            </div>
            
            <div class="mb-3">
                <label class="form-label">Departamento</label>
                <select name="departmentCode" id="departmentSelect" class="form-control" required>
                    <option value="">Seleccionar...</option>
                    <% departments.forEach(dept => { %>
                        <option value="<%= dept.code %>" <%= record.departmentCode === dept.code ? 'selected' : '' %>><%= dept.name %></option>
                    <% }) %>
                </select>
            </div>
            
            <div class="mb-3">
                <label class="form-label">Municipio</label>
                <select name="townCode" id="townSelect" class="form-control" required>
                    <option value="">Cargando...</option>
                </select>
            </div>
            
            <button type="submit" class="btn btn-success">Actualizar</button>
            <a href="/" class="btn btn-secondary">Cancelar</a>
        </form>
    </div>
    
    <script>
        const currentTownCode = '<%= record.townCode %>';
        const currentDepartmentCode = '<%= record.departmentCode %>';
        
        function loadTowns(departmentCode, selectedTownCode = '') {
            const townSelect = document.getElementById('townSelect');
            
            if (departmentCode) {
                fetch(`/api/towns/${departmentCode}`)
                    .then(response => response.json())
                    .then(towns => {
                        townSelect.innerHTML = '<option value="">Seleccionar...</option>';
                        towns.forEach(town => {
                            const selected = town.code === selectedTownCode ? 'selected' : '';
                            townSelect.innerHTML += `<option value="${town.code}" ${selected}>${town.name}</option>`;
                        });
                    })
                    .catch(error => {
                        console.error('Error loading towns:', error);
                        townSelect.innerHTML = '<option value="">Error cargando municipios</option>';
                    });
            }
        }
        
        if (currentDepartmentCode) {
            loadTowns(currentDepartmentCode, currentTownCode);
        }
        
        document.getElementById('departmentSelect').addEventListener('change', function() {
            loadTowns(this.value);
        });
    </script>
</body>
</html>
