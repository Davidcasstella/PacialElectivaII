<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= typeof title !== 'undefined' ? title + ' - ' : '' %><%= appName %></title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">
    <style>
        .navbar-brand { font-weight: bold; }
        .table-actions { width: 150px; }
        .btn-sm { margin: 0 2px; }
    </style>
</head>
<body>
    <nav class="navbar navbar-expand-lg navbar-dark bg-primary">
        <div class="container">
            <a class="navbar-brand" href="/">
                <i class="fas fa-map-marked-alt me-2"></i>
                <%= appName %>
            </a>
        </div>
    </nav>

    <div class="container mt-4">
        <%- body %>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        function loadTowns(departmentCode, targetSelectId, selectedTownCode = '') {
            const townSelect = document.getElementById(targetSelectId);
            townSelect.innerHTML = '<option value="">Seleccione un municipio</option>';
            
            if (!departmentCode) return;
            
            fetch(`/api/towns/${departmentCode}`)
                .then(response => response.json())
                .then(towns => {
                    towns.forEach(town => {
                        const option = document.createElement('option');
                        option.value = town.code;
                        option.textContent = town.name;
                        if (town.code === selectedTownCode) {
                            option.selected = true;
                        }
                        townSelect.appendChild(option);
                    });
                })
                .catch(error => console.error('Error loading towns:', error));
        }
    </script>
</body>
</html>
