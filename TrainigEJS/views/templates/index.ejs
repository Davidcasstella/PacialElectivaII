<!DOCTYPE html>
<html>
<head>
    <title><%= appName %></title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body>
    <div class="container mt-4">
        <h1><%= appName %></h1>
        
        <div class="row mb-3">
            <div class="col-md-12">
                <a href="/create" class="btn btn-primary">Crear Nuevo Registro</a>
                <a href="/search" class="btn btn-info">Buscar por ID</a>
                <a href="/filter" class="btn btn-warning">Filtrar Registros</a>
            </div>
        </div>
        
        <% if (records.length === 0) { %>
            <div class="alert alert-info">
                No hay registros disponibles. <a href="/create">Crear el primero</a>
            </div>
        <% } else { %>
            <table class="table table-striped">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Nombre</th>
                        <th>Email</th>
                        <th>Departamento</th>
                        <th>Municipio</th>
                        <th>Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    <% records.forEach(record => { %>
                        <% const dept = departments.find(d => d.code === record.departmentCode) %>
                        <% const town = towns.find(t => t.code === record.townCode) %>
                        <tr>
                            <td><%= record.id %></td>
                            <td><%= record.name %></td>
                            <td><%= record.email %></td>
                            <td><%= dept ? dept.name : 'N/A' %></td>
                            <td><%= town ? town.name : 'N/A' %></td>
                            <td>
                                <a href="/edit/<%= record.id %>" class="btn btn-sm btn-warning">Editar</a>
                                <form style="display:inline" method="POST" action="/delete/<%= record.id %>">
                                    <button type="submit" class="btn btn-sm btn-danger" onclick="return confirm('¿Eliminar registro?')">Eliminar</button>
                                </form>
                            </td>
                        </tr>
                    <% }) %>
                </tbody>
            </table>
        <% } %>
    </div>
</body>
</html>
