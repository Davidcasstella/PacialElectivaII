<!DOCTYPE html>
<html>
<head>
    <title><%= appName %> - Crear</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body>
    <div class="container mt-4">
        <h1>Crear Nuevo Registro</h1>
        
        <form method="POST" action="/create">
            <div class="mb-3">
                <label class="form-label">Nombre</label>
                <input type="text" name="name" class="form-control" required>
            </div>
            
            <div class="mb-3">
                <label class="form-label">Email</label>
                <input type="email" name="email" class="form-control" required>
            </div>
            
            <div class="mb-3">
                <label class="form-label">Departamento</label>
                <select name="departmentCode" id="departmentSelect" class="form-control" required>
                    <option value="">Seleccionar...</option>
                    <% departments.forEach(dept => { %>
                        <option value="<%= dept.code %>"><%= dept.name %></option>
                    <% }) %>
                </select>
            </div>
            
            <div class="mb-3">
                <label class="form-label">Municipio</label>
                <select name="townCode" id="townSelect" class="form-control" required>
                    <option value="">Seleccionar departamento primero...</option>
                </select>
            </div>
            
            <button type="submit" class="btn btn-success">Guardar</button>
            <a href="/" class="btn btn-secondary">Cancelar</a>
        </form>
    </div>
    
    <script>
        document.getElementById('departmentSelect').addEventListener('change', function() {
            const departmentCode = this.value;
            const townSelect = document.getElementById('townSelect');
            
            if (departmentCode) {
                townSelect.innerHTML = '<option value="">Cargando municipios...</option>';
                townSelect.disabled = true;
                
                fetch(`/api/towns/${departmentCode}`)
                    .then(response => response.json())
                    .then(towns => {
                        townSelect.innerHTML = '<option value="">Seleccionar municipio...</option>';
                        
                        if (towns.length === 0) {
                            townSelect.innerHTML = '<option value="">No hay municipios disponibles</option>';
                        } else {
                            towns.forEach(town => {
                                townSelect.innerHTML += `<option value="${town.code}">${town.name}</option>`;
                            });
                        }
                        townSelect.disabled = false;
                    })
                    .catch(error => {
                        console.error('Error loading towns:', error);
                        townSelect.innerHTML = '<option value="">Error cargando municipios</option>';
                        townSelect.disabled = false;
                    });
            } else {
                townSelect.innerHTML = '<option value="">Seleccionar departamento primero...</option>';
                townSelect.disabled = false;
            }
        });
    </script>
</body>
</html>
