<!DOCTYPE html>
<html>
<head>
    <title><%= appName %> - Filtrar</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body>
    <div class="container mt-4">
        <h1>Filtrar Registros</h1>
        
        <div class="row mb-4">
            <div class="col-md-6">
                <a href="/" class="btn btn-secondary">← Volver al Inicio</a>
            </div>
        </div>
        
        <form method="GET" action="/filter" class="mb-4">
            <div class="row">
                <div class="col-md-4">
                    <label class="form-label">Departamento</label>
                    <select name="departmentCode" id="departmentSelect" class="form-control">
                        <option value="">Todos los departamentos</option>
                        <% departments.forEach(dept => { %>
                            <option value="<%= dept.code %>" <%= selectedDepartment === dept.code ? 'selected' : '' %>>
                                <%= dept.name %>
                            </option>
                        <% }) %>
                    </select>
                </div>
                <div class="col-md-4">
                    <label class="form-label">Municipio</label>
                    <select name="townCode" id="townSelect" class="form-control">
                        <option value="">Todos los municipios</option>
                    </select>
                </div>
                <div class="col-md-4">
                    <label class="form-label">&nbsp;</label>
                    <button type="submit" class="btn btn-primary d-block">Filtrar</button>
                </div>
            </div>
        </form>
        
        <div class="alert alert-info">
            <strong>Total de registros:</strong> <%= records.length %>
        </div>
        
        <table class="table table-striped">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Nombre</th>
                    <th>Email</th>
                    <th>Departamento</th>
                    <th>Municipio</th>
                    <th>Acciones</th>
                </tr>
            </thead>
            <tbody>
                <% records.forEach(record => { %>
                    <% const dept = departments.find(d => d.code === record.departmentCode) %>
                    <% const town = towns.find(t => t.code === record.townCode) %>
                    <tr>
                        <td><%= record.id %></td>
                        <td><%= record.name %></td>
                        <td><%= record.email %></td>
                        <td><%= dept ? dept.name : 'N/A' %></td>
                        <td><%= town ? town.name : 'N/A' %></td>
                        <td>
                            <a href="/edit/<%= record.id %>" class="btn btn-sm btn-warning">Editar</a>
                            <form style="display:inline" method="POST" action="/delete/<%= record.id %>">
                                <button type="submit" class="btn btn-sm btn-danger" 
                                        onclick="return confirm('¿Eliminar registro?')">Eliminar</button>
                            </form>
                        </td>
                    </tr>
                <% }) %>
            </tbody>
        </table>
    </div>
    
    <script>
        const selectedTownCode = '<%= selectedTown %>';
        
        function loadTowns(departmentCode, selectedTownCode = '') {
            const townSelect = document.getElementById('townSelect');
            
            if (departmentCode) {
                fetch(`/api/towns/${departmentCode}`)
                    .then(response => response.json())
                    .then(towns => {
                        townSelect.innerHTML = '<option value="">Todos los municipios</option>';
                        towns.forEach(town => {
                            const selected = town.code === selectedTownCode ? 'selected' : '';
                            townSelect.innerHTML += `<option value="${town.code}" ${selected}>${town.name}</option>`;
                        });
                    });
            } else {
                townSelect.innerHTML = '<option value="">Todos los municipios</option>';
            }
        }
        
        // Load towns on page load if department is selected
        const selectedDept = '<%= selectedDepartment %>';
        if (selectedDept) {
            loadTowns(selectedDept, selectedTownCode);
        }
        
        // Handle department change
        document.getElementById('departmentSelect').addEventListener('change', function() {
            loadTowns(this.value);
        });
    </script>
</body>
</html>
